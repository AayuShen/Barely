#include <winver.h>
#include "version.h"

#ifdef BARELY_DLL
#define BARELY_DESC "Barely taskbar helper (loaded into Explorer)"
#define BARELY_FILE "barely_tap.dll"
#define BARELY_TYPE VFT_DLL
#else
#define BARELY_DESC "Barely - transparent taskbar"
#define BARELY_FILE "barely.exe"
#define BARELY_TYPE VFT_APP
// Per-monitor DPI awareness, modern common controls, runs as the invoking user.
1 24 "barely.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BARELY_VERSION_RC
 PRODUCTVERSION BARELY_VERSION_RC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE BARELY_TYPE
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "AayuShen"
            VALUE "FileDescription", BARELY_DESC
            VALUE "FileVersion", BARELY_VERSION_STR
            VALUE "InternalName", BARELY_FILE
            VALUE "LegalCopyright", "Copyright (c) 2026 AayuShen. Licensed under the MIT License."
            VALUE "OriginalFilename", BARELY_FILE
            VALUE "ProductName", "Barely"
            VALUE "ProductVersion", BARELY_VERSION_STR
            VALUE "Comments", "Created solely by AayuShen."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
